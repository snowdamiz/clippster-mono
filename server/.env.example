# Tokend integration (native provider — secrets stay on Phoenix only)
# Local Tokend: web http://localhost:4100, API http://localhost:4101
# Seed creators (seed-nova, …) only exist after Tokend POST /api/v1/dev/seed-data — not on production tokend.tv
# Public catalog/status use Tokend main's shipped /api/v1/creators/:slug channel/vods/clips/stream routes.
# Partner OAuth/publish/download/watch require a Tokend deployment with /api/v1/oauth/* and /api/v1/partner/*.
# Leave API base unset for local-only mock fixtures. API base alone enables local public-read proxying.
# Live mode represents complete remote config (API base + OAuth client id + secret + redirect URI).
# Partner features additionally require TOKEND_PARTNER_API_ENABLED=true.
# Keep the flag false unless the configured Tokend deployment includes those partner routes.
# Webhook receiver: POST /api/tokend/webhook (HMAC via TOKEND_WEBHOOK_SIGNING_SECRET).
# Local/live public reads fail closed on network/upstream errors; only creator 404s become empty/offline.
TOKEND_API_BASE_URL=
TOKEND_WEB_BASE_URL=http://localhost:4100
TOKEND_OAUTH_CLIENT_ID=
TOKEND_OAUTH_CLIENT_SECRET=
TOKEND_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/tokend/callback
TOKEND_WEBHOOK_SIGNING_SECRET=
TOKEND_PARTNER_API_ENABLED=false

# Freesound API (sound effects search in editor)
FREESOUND_API_KEY=

# Stock B-roll providers (AI B-roll feature)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# TheNewsAPI (breaking news feed for AI context)
THENEWSAPI_KEY=

# AppSignal APM + error tracking
APPSIGNAL_PUSH_API_KEY=your_push_api_key_here

# Deploy Tokens
FLY_SERVER_TOKEN=
FLY_LANDING_TOKEN=
