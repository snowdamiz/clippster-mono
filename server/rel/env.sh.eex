#!/bin/sh

# Set a unique, routable Erlang node name for Fly.io clustering.
# This file is sourced by the Mix release shell script BEFORE the BEAM VM starts,
# so RELEASE_NODE is available when net_kernel configures distribution.
# (System.put_env in runtime.exs is too late — distribution is already configured.)
if [ -n "$FLY_MACHINE_ID" ]; then
  export RELEASE_NODE="${RELEASE_NAME}@${FLY_MACHINE_ID}.vm.${FLY_APP_NAME:-clippster-server}.internal"
fi
