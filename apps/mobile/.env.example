# iOS Simulator / web: localhost works. Android emulator: use 10.0.2.2 (or leave unset — config.ts rewrites localhost on Android).
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.10:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Google OAuth (dev): this redirect URI must be in Google Cloud Console (same as Tauri/desktop):
#   http://localhost:4000/api/auth/google/callback
# Do NOT use 127.0.0.1 or 10.0.2.2 — Google treats them as different URIs.
