{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/composables/useUnsavedChanges": ["src/useUnsavedChanges.ts"],
      "@/services/api": ["src/nativeAccountApi.ts"],
      "@/services/profileMediaRuntime": ["src/profileMediaRuntime.ts"],
      "@/services/settingsRuntime": ["src/settingsRuntime.ts"],
      "@/db/thumbnail-cache": ["src/profileThumbnailCache.ts"],
      "@/services/socialOAuthRuntime": ["src/socialOAuthRuntime.ts"],
      "vue-router": ["src/accountRouter.ts"],
      "@/stores/permissions": ["src/workspacePermissions.ts"],
      "@/services/aiBrollRuntime": ["src/aiBrollRuntime.ts"],
      "@/services/poiRuntime": ["src/poiRuntime.ts"],
      "@/services/workspaceRuntime": ["src/workspaceRuntime.ts"],
      "@/stores/auth": ["src/workspaceAccount.ts"],
      "@/composables/useCreditBalance": ["src/workspaceCredits.ts"],
      "@/services/waveformService": ["src/workspaceWaveform.ts"],
      "@/services/creatorProfileRuntime": ["src/creatorProfileRuntime.ts"],
      "@/services/creatorDownloadRuntime": ["src/creatorDownloadRuntime.ts"],
      "@/composables/useToast": ["src/toasts.ts"],
      "@/stores/userPreferences": ["src/workspacePreferences.ts"],
      "@/*": ["../../client/src/*"],
      "@clippster/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@clippster/api-client": ["../../packages/api-client/src/index.ts"],
      "@clippster/clip-export": ["../../packages/clip-export/src/index.ts"],
      "vue": ["node_modules/vue"],
      "lucide-vue-next": ["node_modules/lucide-vue-next"],
      "hls.js": ["node_modules/hls.js"],
      "vitest": ["node_modules/vitest"],
      "class-variance-authority": ["node_modules/class-variance-authority"],
      "reka-ui": ["node_modules/reka-ui"],
      "radix-vue": ["node_modules/reka-ui"],
      "@vueuse/core": ["node_modules/@vueuse/core"],
      "clsx": ["node_modules/clsx"],
      "tailwind-merge": ["node_modules/tailwind-merge"],
      "axios": ["node_modules/axios"],
      "pinia": ["node_modules/pinia"],
      "@tauri-apps/api/core": ["node_modules/@tauri-apps/api/core"],
      "@tauri-apps/plugin-sql": ["node_modules/@tauri-apps/plugin-sql"],
      "@clippster/cloud-sync-schema": ["../../packages/cloud-sync-schema/src/index.ts"],
      "zod": ["node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/shared-ui/**/*.ts", "tests/shared-ui/**/*.vue", "vite.config.ts"]
}
