# yarn dev / yarn web starts Docker with these ports and bundled media tools.
# Host-only settings below are used by yarn web:host; Docker overrides paths/API.
# Docker API override: export WEB_DOCKER_API_URL=http://host.docker.internal:4000/api
WEB_ORIGIN=http://localhost:5175
CLIPPSTER_API_URL=http://127.0.0.1:4000/api
WEB_DATA_DIR=./data
PORT=8090
# Generate a stable secret with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# macOS: brew install ffmpeg-full; use its keg-only binaries to enable captions.
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# YTDLP_PATH=.venv/bin/yt-dlp
