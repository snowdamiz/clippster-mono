{
  "name": "clippster-monorepo",
  "version": "0.1.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "client": "cd client && yarn dev",
    "server": "cd server && mix phx.server",
    "landing": "cd landing && yarn dev",
    "tauri": "cd client && yarn tauri dev",
    "build": "yarn setup:binaries && cd client && yarn tauri build",
    "setup:binaries": "node scripts/setup-binaries.mjs",
    "dev": "yarn setup:binaries && concurrently \"yarn server\" \"yarn tauri\" \"yarn landing\" --names \"server,client,landing\" --prefix-colors \"blue,magenta,cyan\"",
    "prepare": "husky",
    "format": "cd client && prettier --write \"src/**/*.{vue,js,ts,json,css,scss,md}\"",
    "format:check": "cd client && prettier --check \"src/**/*.{vue,js,ts,json,css,scss,md}\"",
    "format:all": "prettier --write \"client/**/*.{vue,js,ts,json,css,scss,md}\"",
    "format:staged": "cd client && prettier --write",
    "type-check": "cd client && vue-tsc --noEmit",
    "api-demo": "node server.js",
    "api-test": "node kick_api_demo_node.js",
    "css-to-tailwind": "node scripts/css-to-tailwind.mjs",
    "wipe-db": "node scripts/wipe-db.mjs",
    "deploy:server": "node scripts/deploy-fly.mjs server",
    "deploy:landing": "node scripts/deploy-fly.mjs landing"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.13",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "magic-string": "^0.30.17",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-vue": "^1.1.6"
  },
  "lint-staged": {
    "client/**/*.{vue,js,ts,json,css,scss,md}": [
      "yarn format:staged"
    ]
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  }
}
