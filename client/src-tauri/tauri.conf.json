{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clippster",
  "version": "0.1.16",
  "identifier": "com.openworth.clippster",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clippster",
        "width": 1400,
        "height": 850,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "visible": false,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; connect-src 'self' http://localhost:4000 https://clippster-server.fly.dev https://*; img-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost; video-src 'self' asset: https://asset.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:",
      "dangerousDisableAssetCspModification": [".*/.*"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/Clippster/**"]
      }
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:clippster_v25.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1OTY1ODA3QzQ2NzE1NTkKUldSWkZXZkVCMWlXRllQNFpGRDdTazRWUTFGWGVwVGFsWWJlY0s5Nnc2RUJZdnp0WDd6UjhDL2cK",
      "endpoints": [
        "https://github.com/snowdamiz/clippster-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/ffmpeg*",
      "fonts/*",
      "pumpfun-service/**/*"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/node"
    ],
    "windows": {
      "nsis": {},
      "wix": {
        "language": "en-US"
      }
    }
  }
}
