{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:path:default",
    "core:path:allow-resolve",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-open",
    "opener:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-unregister",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$LOCALDATA/Clippster/**"
        },
        {
          "path": "$HOME/Library/Application Support/Clippster/**"
        },
        {
          "path": "$HOME/.local/share/clippster/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$VIDEO/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$LOCALDATA/Clippster/**"
        },
        {
          "path": "$HOME/Library/Application Support/Clippster/**"
        },
        {
          "path": "$HOME/.local/share/clippster/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$LOCALDATA/Clippster/**"
        },
        {
          "path": "$HOME/Library/Application Support/Clippster/**"
        },
        {
          "path": "$HOME/.local/share/clippster/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$LOCALDATA/Clippster/**"
        },
        {
          "path": "$HOME/Library/Application Support/Clippster/**"
        },
        {
          "path": "$HOME/.local/share/clippster/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$LOCALDATA/Clippster/**"
        },
        {
          "path": "$HOME/Library/Application Support/Clippster/**"
        },
        {
          "path": "$HOME/.local/share/clippster/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$LOCALDATA/Clippster/**"
        },
        {
          "path": "$HOME/Library/Application Support/Clippster/**"
        },
        {
          "path": "$HOME/.local/share/clippster/**"
        }
      ]
    }
  ],
  "platforms": ["windows", "macOS", "linux"]
}
