# API Configuration
# The base URL for the Clippster API server
# Prefer 127.0.0.1 over localhost on Windows: localhost resolves to ::1 first,
# and another process (e.g. Docker) may be bound to IPv6 :4000 while Phoenix
# only listens on 127.0.0.1:4000 — causing mass API/WebSocket 404s.
# Production: https://clippster-server.fly.dev
VITE_API_URL=http://127.0.0.1:4000
