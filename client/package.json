{
  "name": "clippster-ui",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{vue,js,ts,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,js,ts,json,css,scss,md}\"",
    "prepare": "husky",
    "analyze": "node ../scripts/analyze-codebase.mjs --vue --html",
    "analyze:all": "node ../scripts/analyze-codebase.mjs --all --html --graph",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "madge:orphans": "madge --orphans --extensions ts --exclude \"\\.vue$\" src/",
    "madge:circular": "madge --circular --extensions ts --exclude \"\\.vue$\" src/",
    "madge:graph": "madge --image ../analysis-output/ts-dependency-graph.svg --extensions ts --exclude \"\\.vue$\" src/"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "~2",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "axios": "^1.7.9",
    "hls.js": "^1.6.15",
    "livekit-client": "^2.9.1",
    "lucide-vue-next": "^0.548.0",
    "md-editor-v3": "^6.1.0",
    "phoenix": "^1.8.1",
    "pinia": "^2.3.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.13",
    "vue-router": "4"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.4.2",
    "@tailwindcss/postcss": "^4.1.16",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^14.0.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "knip": "^5.81.0",
    "lint-staged": "^16.2.6",
    "madge": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-vue": "^1.1.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
