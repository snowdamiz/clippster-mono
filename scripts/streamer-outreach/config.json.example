{
  "sources": ["twitch", "kick", "x"],
  "targetStreamers": 150,
  "minViewers": 5,
  "maxViewers": 100,
  "languages": ["en"],
  "twitchGameIds": [],
  "kickCategoryIds": [],
  "streamPageLimit": 300,
  "xDays": 60,
  "xPageLimit": 100,
  "xQuery": "(\"looking for clippers\" OR \"looking for a clipper\" OR \"need clippers\" OR \"need a clipper\" OR \"hiring clippers\" OR \"hiring a clipper\") -is:retweet",
  "clipsPerStreamer": 3,
  "minClipSeconds": 15,
  "maxClipSeconds": 90,
  "maxSourceSeconds": 7200,
  "vodsToCheck": 20,
  "aspectRatio": "9:16",
  "captions": true,
  "archiveCompletedProjects": true,
  "pollSeconds": 10,
  "jobTimeoutMinutes": 120,
  "outputDir": "./output"
}
