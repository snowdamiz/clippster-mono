# X Developer Console -> your app -> Keys and tokens -> Bearer Token.
# Paste the BEARER TOKEN here, not the API Key / API Key Secret.
X_BEARER_TOKEN=

# Twitch Developer Console -> Applications -> your app.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional app access token instead of the client secret (client ID still required).
TWITCH_ACCESS_TOKEN=

# Kick -> Settings -> Developer -> your app.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Optional app access token instead of client ID + secret.
KICK_ACCESS_TOKEN=

# Same account/API used by the Clippster web workspace.
CLIPPSTER_API_URL=http://127.0.0.1:4000/api
CLIPPSTER_WORKSPACE_URL=http://127.0.0.1:8090/api
CLIPPSTER_ACCOUNT_ORIGIN=http://localhost:5173
CLIPPSTER_EMAIL=
CLIPPSTER_PASSWORD=
# Or use an existing Clippster account JWT instead of email/password.
CLIPPSTER_API_TOKEN=
