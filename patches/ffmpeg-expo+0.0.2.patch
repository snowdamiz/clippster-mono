diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/ass_split.h b/node_modules/ffmpeg-expo/android/include/libavcodec/ass_split.h
new file mode 100644
index 0000000..a45fb9b
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/ass_split.h
@@ -0,0 +1,191 @@
+/*
+ * SSA/ASS spliting functions
+ * Copyright (c) 2010  Aurelien Jacobs <aurel@gnuage.org>
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
