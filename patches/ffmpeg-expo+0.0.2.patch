+/**
+ * @file
+ * Musepack decoder
+ * MPEG Audio Layer 1/2 -like codec with frames of 1152 samples
+ * divided into 32 subbands.
+ */
+
+#ifndef AVCODEC_MPC_H
+#define AVCODEC_MPC_H
+
+#include <stdint.h>
+
+#include "libavutil/lfg.h"
