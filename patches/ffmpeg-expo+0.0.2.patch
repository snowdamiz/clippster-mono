diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/golomb.h b/node_modules/ffmpeg-expo/android/include/libavcodec/golomb.h
new file mode 100644
index 0000000..164c258
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/golomb.h
@@ -0,0 +1,616 @@
+/*
+ * exp golomb vlc stuff
+ * Copyright (c) 2003 Michael Niedermayer <michaelni@gmx.at>
+ * Copyright (c) 2004 Alex Beregszaszi
+ *
+ * This file is part of FFmpeg.
