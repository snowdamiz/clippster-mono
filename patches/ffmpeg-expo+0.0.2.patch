+    uint8_t  *run_bits;
+
+    /** Rate control */
+    unsigned slice_bits;
+    unsigned qscale;
+    unsigned lambda;
+
+    uint32_t *mb_bits;
+    uint8_t  *mb_qscale;
+
+    RCCMPEntry *mb_cmp;
+    RCCMPEntry *mb_cmp_tmp;
+    RCEntry    *mb_rc;
+
+    void (*get_pixels_8x4_sym)(int16_t *av_restrict /* align 16 */ block,
