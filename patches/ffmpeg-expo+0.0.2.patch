diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/snappy.h b/node_modules/ffmpeg-expo/android/include/libavcodec/snappy.h
new file mode 100644
index 0000000..a65cb3a
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/snappy.h
@@ -0,0 +1,60 @@
+/*
+ * Snappy module
+ * Copyright (c) Luca Barbato
