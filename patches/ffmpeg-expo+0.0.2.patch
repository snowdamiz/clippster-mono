+    // Not perfect, but decide whether the packet is a document or not
+    // by the existence of the lavc ttmlenc extradata.
+    return (codecpar->extradata &&
+            codecpar->extradata_size >= TTMLENC_EXTRADATA_SIGNATURE_SIZE &&
