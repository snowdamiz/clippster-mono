index 0000000..350a58f
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/dirac_arith.h
@@ -0,0 +1,201 @@
+/*
+ * Copyright (C) 2007 Marco Gerards <marco@gnu.org>
