+static int ensureConvFrame(AudioXcode& xcode, int nbSamples) {
+    if (xcode.convFrame->data[0] && xcode.convFrame->nb_samples >= nbSamples) {
+        return 0;
+    }
+    av_frame_unref(xcode.convFrame);
+    xcode.convFrame->format = xcode.enc->sample_fmt;
+    xcode.convFrame->sample_rate = xcode.enc->sample_rate;
+    xcode.convFrame->nb_samples = nbSamples;
+    int ret = av_channel_layout_copy(&xcode.convFrame->ch_layout, &xcode.enc->ch_layout);
+    if (ret < 0) return ret;
+    return av_frame_get_buffer(xcode.convFrame, 0);
