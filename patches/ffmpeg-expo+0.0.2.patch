+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/ffjni.h
@@ -0,0 +1,145 @@
+/*
+ * JNI utility functions
+ *
+ * Copyright (c) 2015-2016 Matthieu Bouron <matthieu.bouron stupeflix.com>
+ *
+ * This file is part of FFmpeg.
+ *
