index 0000000..2ac0e67
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/ac3_parser_internal.h
@@ -0,0 +1,84 @@
+/*
+ * AC-3 parser internal code
+ *
