+    if (ret < 0) return ret;
+    if (ret > 0) {
+        if (av_audio_fifo_write(xcode.fifo, reinterpret_cast<void**>(xcode.convFrame->extended_data), ret) < 0) {
+            return AVERROR(ENOMEM);
+        }
+    }
+    return encodeFifoAudio(outputCtx, xcode, clock, false);
+}
+
+static int transcodeAudioPacket(
+    AVFormatContext* outputCtx,
+    AudioXcode& xcode,
+    AVPacket* pkt,
+    StreamClock& clock
+) {
+    int ret = avcodec_send_packet(xcode.dec, pkt);
+    if (ret < 0) return ret;
+
+    while (true) {
+        ret = avcodec_receive_frame(xcode.dec, xcode.decFrame);
+        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) return 0;
+        if (ret < 0) return ret;
+        ret = convertDecodedAudio(outputCtx, xcode, clock);
+        if (ret < 0) return ret;
+    }
+}
+
+static int flushAudioXcode(AVFormatContext* outputCtx, AudioXcode& xcode, StreamClock& clock) {
+    int ret = avcodec_send_packet(xcode.dec, nullptr);
+    if (ret < 0 && ret != AVERROR_EOF) return ret;
+    while (true) {
+        ret = avcodec_receive_frame(xcode.dec, xcode.decFrame);
+        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) break;
+        if (ret < 0) return ret;
+        ret = convertDecodedAudio(outputCtx, xcode, clock);
+        if (ret < 0) return ret;
+    }
+
+    int leftover = swr_get_out_samples(xcode.swr, 0);
+    if (leftover > 0) {
+        ret = ensureConvFrame(xcode, leftover);
+        if (ret < 0) return ret;
+        ret = swr_convert(xcode.swr, xcode.convFrame->extended_data, leftover, nullptr, 0);
+        if (ret < 0) return ret;
+        if (ret > 0 && av_audio_fifo_write(xcode.fifo, reinterpret_cast<void**>(xcode.convFrame->extended_data), ret) < 0) {
+            return AVERROR(ENOMEM);
+        }
+    }
+
+    ret = encodeFifoAudio(outputCtx, xcode, clock, true);
+    if (ret < 0) return ret;
+    ret = avcodec_send_frame(xcode.enc, nullptr);
+    if (ret < 0 && ret != AVERROR_EOF) return ret;
+    return writeEncodedAudio(outputCtx, xcode, clock);
+}
