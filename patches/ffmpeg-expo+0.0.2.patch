+#endif /* AVUTIL_TIME_INTERNAL_H */
diff --git a/node_modules/ffmpeg-expo/android/include/libavutil/timecode.h b/node_modules/ffmpeg-expo/android/include/libavutil/timecode.h
new file mode 100644
index 0000000..060574a
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavutil/timecode.h
@@ -0,0 +1,199 @@
+/*
+ * Copyright (c) 2006 Smartjog S.A.S, Baptiste Coudurier <baptiste.coudurier@gmail.com>
+ * Copyright (c) 2011-2012 Smartjog S.A.S, Clément Bœsch <clement.boesch@smartjog.com>
