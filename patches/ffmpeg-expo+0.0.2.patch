--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavutil/mips/generic_macros_msa.h
@@ -0,0 +1,2821 @@
+/*
+ * Copyright (c) 2015 Manojkumar Bhosale (Manojkumar.Bhosale@imgtec.com)
+ *
+ * This file is part of FFmpeg.
+ *
