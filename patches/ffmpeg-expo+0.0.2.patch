+static int encodeFifoAudio(AVFormatContext* outputCtx, AudioXcode& xcode, StreamClock& clock, bool flush) {
+    const int frameSize = xcode.enc->frame_size > 0 ? xcode.enc->frame_size : 1024;
+    if (flush) {
+        const int remain = av_audio_fifo_size(xcode.fifo);
+        if (remain > 0 && remain < frameSize) {
+            const int pad = frameSize - remain;
+            uint8_t** silence = nullptr;
+            int ret = av_samples_alloc_array_and_samples(
+                &silence, nullptr, xcode.enc->ch_layout.nb_channels, pad, xcode.enc->sample_fmt, 0);
+            if (ret < 0) return ret;
+            av_samples_set_silence(silence, 0, pad, xcode.enc->ch_layout.nb_channels, xcode.enc->sample_fmt);
+            ret = av_audio_fifo_write(xcode.fifo, reinterpret_cast<void**>(silence), pad);
+            av_freep(&silence[0]);
+            av_freep(&silence);
+            if (ret < 0) return ret;
+        }
+    }
