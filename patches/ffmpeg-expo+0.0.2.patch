diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/twinvq.h b/node_modules/ffmpeg-expo/android/include/libavcodec/twinvq.h
new file mode 100644
index 0000000..84f4e51
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/twinvq.h
@@ -0,0 +1,213 @@
+/*
+ * TwinVQ decoder
+ * Copyright (c) 2009 Vitor Sessak
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
