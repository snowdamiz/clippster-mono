diff --git a/node_modules/ffmpeg-expo/android/include/libavutil/hwcontext_d3d11va.h b/node_modules/ffmpeg-expo/android/include/libavutil/hwcontext_d3d11va.h
new file mode 100644
index 0000000..77d2d72
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavutil/hwcontext_d3d11va.h
@@ -0,0 +1,178 @@
+/*
