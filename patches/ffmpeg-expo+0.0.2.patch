diff --git a/node_modules/ffmpeg-expo/android/include/libavformat/subtitles.h b/node_modules/ffmpeg-expo/android/include/libavformat/subtitles.h
new file mode 100644
index 0000000..f4993fe
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavformat/subtitles.h
@@ -0,0 +1,230 @@
+/*
