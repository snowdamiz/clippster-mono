diff --git a/node_modules/ffmpeg-expo/android/include/libavformat/demux.h b/node_modules/ffmpeg-expo/android/include/libavformat/demux.h
new file mode 100644
index 0000000..1f57e06
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavformat/demux.h
@@ -0,0 +1,241 @@
