diff --git a/node_modules/ffmpeg-expo/android/include/libavutil/hwcontext_vaapi.h b/node_modules/ffmpeg-expo/android/include/libavutil/hwcontext_vaapi.h
new file mode 100644
index 0000000..0b2e071
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavutil/hwcontext_vaapi.h
@@ -0,0 +1,117 @@
+/*
