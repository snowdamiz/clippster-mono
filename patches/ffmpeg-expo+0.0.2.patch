diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/xvmc.h b/node_modules/ffmpeg-expo/android/include/libavcodec/xvmc.h
new file mode 100644
index 0000000..52e70c0
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/xvmc.h
@@ -0,0 +1,171 @@
