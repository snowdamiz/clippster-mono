diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/arm/vpx_arith.h b/node_modules/ffmpeg-expo/android/include/libavcodec/arm/vpx_arith.h
new file mode 100644
index 0000000..1ead228
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/arm/vpx_arith.h
@@ -0,0 +1,121 @@
+/*
+ * Copyright (C) 2010 Mans Rullgard <mans@mansr.com>
+ *
