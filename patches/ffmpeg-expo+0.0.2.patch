diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/to_upper4.h b/node_modules/ffmpeg-expo/android/include/libavcodec/to_upper4.h
new file mode 100644
index 0000000..d9648b5
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/to_upper4.h
@@ -0,0 +1,37 @@
+/*
+ * Converting FOURCCs to uppercase
+ * Copyright (c) 2001 Fabrice Bellard
+ * Copyright (c) 2002-2004 Michael Niedermayer <michaelni@gmx.at>
+ *
+ * This file is part of FFmpeg.
