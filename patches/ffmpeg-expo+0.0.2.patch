diff --git a/node_modules/ffmpeg-expo/android/include/libavfilter/transform.h b/node_modules/ffmpeg-expo/android/include/libavfilter/transform.h
new file mode 100644
index 0000000..0344f9c
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavfilter/transform.h
@@ -0,0 +1,108 @@
+/*
