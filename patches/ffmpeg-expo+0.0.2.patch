diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/vaapi_encode.h b/node_modules/ffmpeg-expo/android/include/libavcodec/vaapi_encode.h
new file mode 100644
index 0000000..d0d6cc2
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/vaapi_encode.h
@@ -0,0 +1,540 @@
+/*
