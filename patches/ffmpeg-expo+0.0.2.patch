index 0000000..4561dc1
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/put_bits.h
@@ -0,0 +1,428 @@
+/*
+ * copyright (c) 2004 Michael Niedermayer <michaelni@gmx.at>
+ *
