diff --git a/node_modules/ffmpeg-expo/android/include/libavutil/softfloat.h b/node_modules/ffmpeg-expo/android/include/libavutil/softfloat.h
new file mode 100644
index 0000000..399ca6d
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavutil/softfloat.h
@@ -0,0 +1,293 @@
+/*
