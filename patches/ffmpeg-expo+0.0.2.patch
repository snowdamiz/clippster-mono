diff --git a/node_modules/ffmpeg-expo/android/include/libavformat/flv.h b/node_modules/ffmpeg-expo/android/include/libavformat/flv.h
new file mode 100644
index 0000000..f710963
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavformat/flv.h
@@ -0,0 +1,154 @@
+/*
+ * FLV common header
+ *
+ * Copyright (c) 2006 The FFmpeg Project
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
