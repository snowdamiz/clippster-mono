+static int setupAudioXcode(AVStream* inStream, AVStream* outStream, int64_t bitrate, AudioXcode* xcode) {
+    const AVCodec* decoder = avcodec_find_decoder(inStream->codecpar->codec_id);
+    const AVCodec* encoder = avcodec_find_encoder(AV_CODEC_ID_AAC);
+    if (!decoder || !encoder) {
+        sessionLog(AV_LOG_ERROR, "AAC transcode requires audio decoder + aac encoder");
+        return AVERROR_DECODER_NOT_FOUND;
+    }
+
+    xcode->dec = avcodec_alloc_context3(decoder);
+    xcode->enc = avcodec_alloc_context3(encoder);
+    if (!xcode->dec || !xcode->enc) return AVERROR(ENOMEM);
+
+    int ret = avcodec_parameters_to_context(xcode->dec, inStream->codecpar);
+    if (ret < 0) return ret;
+    ret = avcodec_open2(xcode->dec, decoder, nullptr);
+    if (ret < 0) return ret;
+
+    xcode->enc->sample_rate = xcode->dec->sample_rate > 0 ? xcode->dec->sample_rate : 48000;
+    ret = av_channel_layout_copy(&xcode->enc->ch_layout, &xcode->dec->ch_layout);
+    if (ret < 0 || xcode->enc->ch_layout.nb_channels <= 0) {
+        av_channel_layout_default(&xcode->enc->ch_layout, 2);
+    }
+    xcode->enc->bit_rate = bitrate > 0 ? bitrate : 128000;
+    xcode->enc->sample_fmt = encoder->sample_fmts ? encoder->sample_fmts[0] : AV_SAMPLE_FMT_FLTP;
+    xcode->enc->time_base = AVRational{1, xcode->enc->sample_rate};
+    outStream->time_base = xcode->enc->time_base;
+
+    ret = avcodec_open2(xcode->enc, encoder, nullptr);
+    if (ret < 0) return ret;
+
+    ret = avcodec_parameters_from_context(outStream->codecpar, xcode->enc);
+    if (ret < 0) return ret;
+    outStream->codecpar->codec_tag = 0;
+
+    ret = swr_alloc_set_opts2(
+        &xcode->swr,
+        &xcode->enc->ch_layout, xcode->enc->sample_fmt, xcode->enc->sample_rate,
+        &xcode->dec->ch_layout, xcode->dec->sample_fmt, xcode->dec->sample_rate,
+        0, nullptr);
+    if (ret < 0) return ret;
+    ret = swr_init(xcode->swr);
+    if (ret < 0) return ret;
+
+    xcode->decFrame = av_frame_alloc();
+    xcode->encFrame = av_frame_alloc();
+    xcode->convFrame = av_frame_alloc();
+    xcode->encPkt = av_packet_alloc();
+    xcode->fifo = av_audio_fifo_alloc(
+        xcode->enc->sample_fmt, xcode->enc->ch_layout.nb_channels, 1024);
+    if (!xcode->decFrame || !xcode->encFrame || !xcode->convFrame ||
+        !xcode->encPkt || !xcode->fifo) {
