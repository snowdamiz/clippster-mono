diff --git a/node_modules/ffmpeg-expo/android/include/libavcodec/x86/inline_asm.h b/node_modules/ffmpeg-expo/android/include/libavcodec/x86/inline_asm.h
new file mode 100644
index 0000000..0198746
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/x86/inline_asm.h
@@ -0,0 +1,100 @@
+/*
+ * inline assembly helper macros
+ *
+ * This file is part of FFmpeg.
+ *
