+    while (av_audio_fifo_size(xcode.fifo) >= frameSize) {
+        int ret = av_frame_make_writable(xcode.encFrame);
+        if (ret < 0) return ret;
+        xcode.encFrame->nb_samples = frameSize;
+        if (av_audio_fifo_read(xcode.fifo, reinterpret_cast<void**>(xcode.encFrame->data), frameSize) < frameSize) {
+            return AVERROR(EINVAL);
+        }
+        xcode.encFrame->pts = xcode.nextPts;
+        xcode.nextPts += frameSize;
+        ret = avcodec_send_frame(xcode.enc, xcode.encFrame);
+        if (ret < 0) return ret;
+        ret = writeEncodedAudio(outputCtx, xcode, clock);
+        if (ret < 0) return ret;
+    }
+    return 0;
+}
+
+static int convertDecodedAudio(AVFormatContext* outputCtx, AudioXcode& xcode, StreamClock& clock) {
+    int outSamples = swr_get_out_samples(xcode.swr, xcode.decFrame->nb_samples);
+    if (outSamples < 1) outSamples = xcode.decFrame->nb_samples;
+    int ret = ensureConvFrame(xcode, outSamples);
+    if (ret < 0) return ret;
+    ret = swr_convert(
+        xcode.swr,
+        xcode.convFrame->extended_data, outSamples,
+        reinterpret_cast<const uint8_t**>(xcode.decFrame->extended_data),
+        xcode.decFrame->nb_samples);
