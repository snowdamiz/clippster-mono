index 0000000..bae6962
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/include/libavcodec/mpegaudio_tablegen.h
@@ -0,0 +1,89 @@
+/*
+ * Header file for hardcoded mpegaudiodec tables
+ *
+ * Copyright (c) 2009 Reimar Döffinger <Reimar.Doeffinger@gmx.de>
+ *
