+/**
+ * @file
+ * mpegvideo decoder header.
+ */
+
+#ifndef AVCODEC_MPEGVIDEODEC_H
+#define AVCODEC_MPEGVIDEODEC_H
+
+#include "libavutil/frame.h"
+#include "libavutil/log.h"
+
+#include "avcodec.h"
+#include "get_bits.h"
+#include "mpegpicture.h"
