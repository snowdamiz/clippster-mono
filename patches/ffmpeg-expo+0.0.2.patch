diff --git a/node_modules/ffmpeg-expo/android/build.gradle b/node_modules/ffmpeg-expo/android/build.gradle
new file mode 100644
index 0000000..9b482eb
--- /dev/null
+++ b/node_modules/ffmpeg-expo/android/build.gradle
@@ -0,0 +1,60 @@
+plugins {
+  id 'com.android.library'
+  id 'expo-module-gradle-plugin'
+}
+
+group = 'expo.modules.ffmpeg'
+version = '1.0.0'
+
+android {
+  namespace 'expo.modules.ffmpeg'
+
+  defaultConfig {
+    versionCode 1
+    versionName '1.0.0'
+
+    ndk {
+      abiFilters 'arm64-v8a', 'armeabi-v7a', 'x86_64'
+    }
+
+    externalNativeBuild {
+      cmake {
+        cppFlags '-std=c++17'
+        arguments '-DANDROID_STL=c++_shared'
+      }
+    }
+  }
+
+  buildTypes {
+    release {
+      minifyEnabled false
+    }
+  }
+
+  externalNativeBuild {
+    cmake {
+      path 'CMakeLists.txt'
+      version '3.22.1'
+    }
+  }
+
+  compileOptions {
+    sourceCompatibility JavaVersion.VERSION_17
+    targetCompatibility JavaVersion.VERSION_17
+  }
+
+  kotlinOptions {
+    jvmTarget = '17'
+  }
+
+  sourceSets {
+    main {
+      jniLibs.srcDirs = ['jniLibs']
+    }
+  }
+}
+
+dependencies {
+  implementation 'org.jetbrains.kotlinx:kotlinx-coroutines-core:1.7.3'
+  implementation 'org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3'
+}
