+    xcode->encFrame->format = xcode->enc->sample_fmt;
+    xcode->encFrame->sample_rate = xcode->enc->sample_rate;
+    xcode->encFrame->nb_samples = xcode->enc->frame_size > 0 ? xcode->enc->frame_size : 1024;
+    ret = av_channel_layout_copy(&xcode->encFrame->ch_layout, &xcode->enc->ch_layout);
+    if (ret < 0) return ret;
+    ret = av_frame_get_buffer(xcode->encFrame, 0);
