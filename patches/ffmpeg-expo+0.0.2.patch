+static int writeEncodedAudio(AVFormatContext* outputCtx, AudioXcode& xcode, StreamClock& clock) {
+    int ret = 0;
+    while (ret >= 0) {
+        ret = avcodec_receive_packet(xcode.enc, xcode.encPkt);
+        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) return 0;
+        if (ret < 0) return ret;
