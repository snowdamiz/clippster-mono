+/**
+ * Concatenated HLS/MPEG-TS has discontinuities at every segment join.
+ * ExoPlayer freezes when DTS goes backwards — rewrite a monotonic timeline.
+ */
+static void rescaleAndFixTs(AVPacket* pkt, AVRational inTb, AVRational outTb, StreamClock& clock) {
+    if (pkt->pts != AV_NOPTS_VALUE) {
+        pkt->pts = av_rescale_q_rnd(
+            pkt->pts, inTb, outTb,
+            static_cast<AVRounding>(AV_ROUND_NEAR_INF | AV_ROUND_PASS_MINMAX));
+    }
+    if (pkt->dts != AV_NOPTS_VALUE) {
+        pkt->dts = av_rescale_q_rnd(
+            pkt->dts, inTb, outTb,
+            static_cast<AVRounding>(AV_ROUND_NEAR_INF | AV_ROUND_PASS_MINMAX));
+    }
+    if (pkt->duration > 0) {
+        pkt->duration = av_rescale_q(pkt->duration, inTb, outTb);
+    }
+    if (pkt->dts == AV_NOPTS_VALUE) {
+        pkt->dts = pkt->pts;
+    }
+    if (pkt->pts == AV_NOPTS_VALUE) {
+        pkt->pts = pkt->dts;
+    }
+    if (pkt->dts == AV_NOPTS_VALUE) {
+        pkt->dts = clock.lastDts == AV_NOPTS_VALUE ? 0 : clock.lastDts + 1;
+        pkt->pts = pkt->dts;
+    }
+    if (clock.lastDts != AV_NOPTS_VALUE && pkt->dts <= clock.lastDts) {
+        const int64_t shift = clock.lastDts - pkt->dts + 1;
+        pkt->dts += shift;
+        if (pkt->pts != AV_NOPTS_VALUE) {
+            pkt->pts += shift;
+        }
+    }
+    if (pkt->pts != AV_NOPTS_VALUE && pkt->pts < pkt->dts) {
+        pkt->pts = pkt->dts;
+    }
+    clock.lastDts = pkt->dts;
+    pkt->pos = -1;
+}
