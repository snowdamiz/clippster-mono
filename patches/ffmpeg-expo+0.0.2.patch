+
+static bool looksLikeImageOutput(const char* path) {
+    if (!path) return false;
+    const char* dot = strrchr(path, '.');
+    if (!dot) return false;
+    return strcasecmp(dot, ".jpg") == 0 || strcasecmp(dot, ".jpeg") == 0 ||
+           strcasecmp(dot, ".png") == 0 || strcasecmp(dot, ".webp") == 0 ||
+           strcasecmp(dot, ".bmp") == 0;
+}
+
+static CommandOptions parseArgs(const std::vector<char*>& argv) {
+    CommandOptions opts;
+    for (size_t i = 1; i < argv.size(); i++) {
+        const char* arg = argv[i];
+        if (strcmp(arg, "-i") == 0 && i + 1 < argv.size()) {
+            opts.inputFile = argv[++i];
+        } else if (strcmp(arg, "-c:v") == 0 && i + 1 < argv.size()) {
+            opts.videoCodec = argv[++i];
+        } else if ((strcmp(arg, "-c:a") == 0 || strcmp(arg, "-acodec") == 0) && i + 1 < argv.size()) {
+            opts.audioCodec = argv[++i];
+        } else if (strcmp(arg, "-bsf:a") == 0 && i + 1 < argv.size()) {
+            opts.audioBsf = argv[++i];
+        } else if (strcmp(arg, "-ss") == 0 && i + 1 < argv.size()) {
+            opts.startSeconds = atof(argv[++i]);
+        } else if (strcmp(arg, "-t") == 0 && i + 1 < argv.size()) {
+            opts.durationSeconds = atof(argv[++i]);
+        } else if (strcmp(arg, "-headers") == 0 && i + 1 < argv.size()) {
+            opts.headers = argv[++i];
+        } else if (strcmp(arg, "-user_agent") == 0 && i + 1 < argv.size()) {
+            opts.userAgent = argv[++i];
+        } else if (strcmp(arg, "-b:a") == 0 && i + 1 < argv.size()) {
+            const char* rate = argv[++i];
+            double value = atof(rate);
+            if (strchr(rate, 'k') || strchr(rate, 'K')) {
+                value *= 1000;
+            }
+            if (value > 0) opts.audioBitrate = static_cast<int64_t>(value);
+        } else if (strcmp(arg, "-vn") == 0) {
+            opts.dropVideo = true;
+        } else if (strcmp(arg, "-an") == 0) {
+            opts.dropAudio = true;
+        } else if (strcmp(arg, "-y") == 0) {
+            opts.overwrite = true;
+        } else if (strcmp(arg, "-frames:v") == 0 || strcmp(arg, "-vframes") == 0) {
+            opts.wantsFrameExtract = true;
+            if (i + 1 < argv.size() && argv[i + 1][0] != '-') {
+                ++i;
+            }
+        } else if (arg[0] != '-' && i == argv.size() - 1) {
+            opts.outputFile = arg;
+        } else if (strcmp(arg, "-q:a") == 0 ||
+                   strcmp(arg, "-q:v") == 0 || strcmp(arg, "-c") == 0 ||
+                   strcmp(arg, "-movflags") == 0 || strcmp(arg, "-fflags") == 0 ||
+                   strcmp(arg, "-avoid_negative_ts") == 0 ||
+                   strcmp(arg, "-map") == 0 || strcmp(arg, "-reconnect") == 0 ||
+                   strcmp(arg, "-reconnect_streamed") == 0 ||
+                   strcmp(arg, "-reconnect_delay_max") == 0 ||
+                   strcmp(arg, "-http_persistent") == 0 ||
+                   strcmp(arg, "-multiple_requests") == 0 ||
+                   strcmp(arg, "-timeout") == 0 || strcmp(arg, "-rw_timeout") == 0 ||
+                   strcmp(arg, "-probesize") == 0 || strcmp(arg, "-analyzeduration") == 0 ||
+                   strcmp(arg, "-max_muxing_queue_size") == 0) {
+            if (i + 1 < argv.size() && argv[i + 1][0] != '-') {
+                ++i;
+            }
+        }
+    }
+    return opts;
+}
