rn;\n const elements=layers.filter(layer=>layer.kind==='element'&&!overrides[layer.key]?.deleted).map(layer=>({layer,node:root.querySelector(layer.selector)}));\n const candidates=elements.filter(item=>item.node?.contains(event.target));\n const fallback=elements.filter(({node})=>{if(!node)return false;const rect=node.getBoundingClientRect(),style=getComputedStyle(node);return style.visibility==='visible'&&Number(style.opacity)>.001&&event.clientX>=rect.left&&event.clientX<=rect.right&&event.clientY>=rect.top&&event.clientY<=rect.bottom;}).sort((a,b)=>{const ar=a.node.getBoundingClientRect(),br=b.node.getBoundingClientRect();return ar.width*ar.height-br.width*br.height;});\n const item=candidates.sort((a,b)=>b.layer.selector.length-a.layer.selector.length)[0]||fallback[0];\n if(item)window.parent.postMessage({type:'clippster-layer-selected',owner:variables.__editorOwner,key:item.layer.key},'*');\n});\nif(variables.__editorOwner)window.parent.postMessage({type:'clippster-scene-layers',owner:variables.__editorOwner,layers},'*');\n})();</script></template></body></html>\n","index.html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Clippster: Catch, Clip, Share</title>\n    <script src=\"assets/vendor/gsap.min.js\"></script>\n    <style>\n      @font-face { font-family: \"Montserrat\"; src: url(\"assets/fonts/Montserrat-Bold.ttf\") format(\"truetype\"); font-weight: 700; font-style: normal; }\n      @font-face { font-family: \"Montserrat\"; src: url(\"assets/fonts/Montserrat-Black.ttf\") format(\"truetype\"); font-weight: 900; font-style: normal; }\n      * { margin: 0; padding: 0; box-sizing: border-box; }\n      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #000; }\n      .frame { position: absolute; inset: 0; z-index: 1; }\n      .frame > .clip { position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; }\n      .fx { position: absolute; inset: 0; z-index: 10; pointer-events: none; opacity: 0; }\n      #fx-flash { background: #fff; }\n      #fx-dip { background: #000; }\n      .overlay { position: absolute; inset: 0; }\n      .overlay-graphics { z-index: 20; }\n      .overlay-text { z-index: 30; }\n    </style>\n  </head>\n  <body>\n    <div id=\"root\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"13\" data-width=\"1920\" data-height=\"1080\" data-fps=\"30\">\n      <div id=\"shot-catch-frame\" class=\"frame\"><div id=\"shot-catch\" class=\"clip\" data-slot-id=\"catch\" data-composition-id=\"catch\" data-composition-src=\"compositions/catch.html\" data-start=\"0\" data-duration=\"5\" data-track-index=\"0\" data-width=\"1920\" data-height=\"1080\" data-variable-values=\"{&quot;text&quot;:&quot;Export parity checked&quot;,&quot;__editorLayers&quot;:&quot;{\\&quot;element:div:nth-child(1) &gt; div:nth-child(3) &gt; svg:nth-child(4)\\&quot;:{\\&quot;deleted\\&quot;:true},\\&quot;element:div:nth-child(1) &gt; div:nth-child(1)\\&quot;:{\\&quot;styles\\&quot;:{\\&quot;background\\&quot;:\\&quot;#123456\\&quot;}}}&quot;,&quot;__editorTimeScale&quot;:1.25,&quot;__editorOwner&quot;:&quot;catch&quot;,&quot;__editorDuration&quot;:5}\"></div></div>\n      <div id=\"shot-clips-frame\" class=\"frame\"><div id=\"shot-clips\" class=\"clip\" data-slot-id=\"clips\" data-composition-id=\"clips\" data-composition-src=\"compositions/clips.html\" data-start=\"5\" data-duration=\"4\" data-track-index=\"0\" data-width=\"1920\" data-height=\"1080\" data-variable-values=\"{&quot;text&quot;:&quot;Make it a clip&quot;,&quot;__editorOwner&quot;:&quot;clips&quot;,&quot;__editorDuration&quot;:4}\"></div></div>\n      <div id=\"shot-share-frame\" class=\"frame\"><div id=\"shot-share\" class=\"clip\" data-slot-id=\"share\" data-composition-id=\"share\" data-composition-src=\"compositions/share.html\" data-start=\"9\" data-duration=\"4\" data-track-index=\"0\" data-width=\"1920\" data-height=\"1080\" data-variable-values=\"{&quot;text&quot;:&quot;Share your best&quot;,&quot;wordmark&quot;:&quot;Clippster&quot;,&quot;__editorOwner&quot;:&quot;share&quot;,&quot;__editorDuration&quot;:4}\"></div></div>\n      <div id=\"fx-dip\" class=\"fx\"></div>\n      <div id=\"fx-flash\" class=\"fx\"></div>\n\n    </div>\n    <script>\n      window.__timelines ??= {};\n      const tl = gsap.timeline({ paused: true });\n      tl.set(\"#fx-flash\", { opacity: 0 }, 0);\n      tl.set(\"#fx-dip\", { opacity: 0 }, 0);\n      tl.set(\"#fx-flash\", { opacity: 1 }, 5);\n      tl.to(\"#fx-flash\", { opacity: 0, duration: 0.2, ease: \"power2.out\" }, 5);\n      window.__timelines[\"main\"] = tl;\n    </script>\n  </body>\n</html>\n"}